# ==========================================
# Dependencias
# ==========================================
/node_modules
/.pnpm-store
/.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ==========================================
# Compilación y Salidas de Next.js
# ==========================================
/.next/
/out/
/build
/dist

# ==========================================
# Archivos de Entorno y Secretos (CRÍTICO)
# ==========================================
# ¡Nunca subir claves de TiDB Cloud o Vercel!
.env
.env*.local
.env.production
.env.development

# ==========================================
# Vercel y Archivos de Despliegue
# ==========================================
.vercel

# ==========================================
# Caché de Herramientas y Compiladores
# ==========================================
.swc
.turbo
.eslintcache
.tsconfig.tsbuildinfo

# ==========================================
# Logs y Rastros de Ejecución
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ==========================================
# Archivos del Sistema Operativo y Editores
# ==========================================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editores de código / IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
